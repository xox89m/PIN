rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1: Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    function isValidUid(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_.:-]+$');
    }

    function isBoundedString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        (request.auth.token.email is string &&
          request.auth.token.email.size() <= 254 &&
          request.auth.token.email.lower() == 'xox89m97@gmail.com') ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidGlobalBarsMap(m) {
      return m is map &&
        m.keys().hasAll([
          'adminLoginBtn', 'soundMutedBtn', 'soundTapToPlayBtn', 'soundPlayingSfxOnlyBtn'
        ]) &&
        m.keys().hasOnly([
          'adminLoginBtn', 'soundMutedBtn', 'soundTapToPlayBtn', 'soundPlayingSfxOnlyBtn'
        ]) &&
        isBoundedString(m.adminLoginBtn, 0, 200) &&
        isBoundedString(m.soundMutedBtn, 0, 200) &&
        isBoundedString(m.soundTapToPlayBtn, 0, 200) &&
        isBoundedString(m.soundPlayingSfxOnlyBtn, 0, 200);
    }

    function isValidCoverMap(m) {
      return m is map &&
        m.keys().hasAll(['subtitleLine1', 'subtitleLine2', 'startBtn', 'readAllLettersBtn']) &&
        m.keys().hasOnly(['subtitleLine1', 'subtitleLine2', 'startBtn', 'readAllLettersBtn']) &&
        isBoundedString(m.subtitleLine1, 0, 500) &&
        isBoundedString(m.subtitleLine2, 0, 500) &&
        isBoundedString(m.startBtn, 1, 200) &&
        isBoundedString(m.readAllLettersBtn, 0, 200);
    }

    function isValidStepAMap(m) {
      return m is map &&
        m.keys().hasAll([
          'homeBtn', 'backBtn', 'initialQuestion', 'yesBtn', 'noBtn',
          'waitMessage', 'waitSubLabel', 'waitFollowUp',
          'actuallyMeBtn', 'reallyNotMeBtn', 'politeExitTitle', 'politeExitBody', 'politeExitReadBtn'
        ]) &&
        m.keys().hasOnly([
          'homeBtn', 'backBtn', 'initialQuestion', 'yesBtn', 'noBtn',
          'waitMessage', 'waitSubLabel', 'waitFollowUp',
          'actuallyMeBtn', 'reallyNotMeBtn', 'politeExitTitle', 'politeExitBody', 'politeExitReadBtn'
        ]) &&
        isBoundedString(m.homeBtn, 0, 200) &&
        isBoundedString(m.backBtn, 0, 200) &&
        isBoundedString(m.initialQuestion, 0, 500) &&
        isBoundedString(m.yesBtn, 0, 200) &&
        isBoundedString(m.noBtn, 0, 200) &&
        isBoundedString(m.waitMessage, 0, 500) &&
        isBoundedString(m.waitSubLabel, 0, 200) &&
        isBoundedString(m.waitFollowUp, 0, 500) &&
        isBoundedString(m.actuallyMeBtn, 0, 300) &&
        isBoundedString(m.reallyNotMeBtn, 0, 300) &&
        isBoundedString(m.politeExitTitle, 0, 500) &&
        isBoundedString(m.politeExitBody, 0, 1000) &&
        isBoundedString(m.politeExitReadBtn, 0, 200);
    }

    function isValidStepBMap(m) {
      return m is map &&
        m.keys().hasAll([
          'backBtn', 'question', 'yearRangeHint', 'submitBtn', 'skipToReadBtn', 'wrongDateMessage'
        ]) &&
        m.keys().hasOnly([
          'backBtn', 'question', 'yearRangeHint', 'submitBtn', 'skipToReadBtn', 'wrongDateMessage'
        ]) &&
        isBoundedString(m.backBtn, 0, 200) &&
        isBoundedString(m.question, 0, 400) &&
        isBoundedString(m.yearRangeHint, 0, 300) &&
        isBoundedString(m.submitBtn, 0, 200) &&
        isBoundedString(m.skipToReadBtn, 0, 200) &&
        isBoundedString(m.wrongDateMessage, 0, 600);
    }

    function isValidStepCMap(m) {
      return m is map &&
        m.keys().hasAll([
          'mailboxHeading', 'deskHintClosed', 'birthdayEnvelopeTag', 'apologyEnvelopeTag',
          'extraEnvelopeTag', 'skipOpenAnimBtn', 'continueDraftBtn',
          'mailboxBoxTitle', 'mailboxSubtitle', 'letterCountUnit', 'foldBackBtn',
          'writeReplyBtn', 'writeNewReplyBtn', 'writeShortBtn',
          'replySenderPrefix', 'untitledReplyLabel', 'emptyReplyBodyLabel',
          'referenceIdLabel', 'editReplyBtn', 'syncedBadgeLabel', 'localDraftBadgeLabel',
          'privacyFooterNote'
        ]) &&
        m.keys().hasOnly([
          'mailboxHeading', 'deskHintClosed', 'birthdayEnvelopeTag', 'apologyEnvelopeTag',
          'extraEnvelopeTag', 'skipOpenAnimBtn', 'continueDraftBtn',
          'mailboxBoxTitle', 'mailboxSubtitle', 'letterCountUnit', 'foldBackBtn',
          'writeReplyBtn', 'writeNewReplyBtn', 'writeShortBtn',
          'replySenderPrefix', 'untitledReplyLabel', 'emptyReplyBodyLabel',
          'referenceIdLabel', 'editReplyBtn', 'syncedBadgeLabel', 'localDraftBadgeLabel',
          'privacyFooterNote'
        ]) &&
        isBoundedString(m.mailboxHeading, 0, 300) &&
        isBoundedString(m.deskHintClosed, 0, 500) &&
        isBoundedString(m.birthdayEnvelopeTag, 0, 300) &&
        isBoundedString(m.apologyEnvelopeTag, 0, 300) &&
        isBoundedString(m.extraEnvelopeTag, 0, 300) &&
        isBoundedString(m.skipOpenAnimBtn, 0, 200) &&
        isBoundedString(m.continueDraftBtn, 0, 200) &&
        isBoundedString(m.mailboxBoxTitle, 0, 300) &&
        isBoundedString(m.mailboxSubtitle, 0, 400) &&
        isBoundedString(m.letterCountUnit, 0, 100) &&
        isBoundedString(m.foldBackBtn, 0, 200) &&
        isBoundedString(m.writeReplyBtn, 0, 200) &&
        isBoundedString(m.writeNewReplyBtn, 0, 200) &&
        isBoundedString(m.writeShortBtn, 0, 200) &&
        isBoundedString(m.replySenderPrefix, 0, 100) &&
        isBoundedString(m.untitledReplyLabel, 0, 200) &&
        isBoundedString(m.emptyReplyBodyLabel, 0, 300) &&
        isBoundedString(m.referenceIdLabel, 0, 200) &&
        isBoundedString(m.editReplyBtn, 0, 200) &&
        isBoundedString(m.syncedBadgeLabel, 0, 200) &&
        isBoundedString(m.localDraftBadgeLabel, 0, 200) &&
        isBoundedString(m.privacyFooterNote, 0, 600);
    }

    function isValidStepDMap(m) {
      return m is map &&
        m.keys().hasAll([
          'backBtn', 'heading', 'privacyNoticeBody', 'deletionPolicyNote',
          'titleLabel', 'titlePlaceholder', 'authorLabel', 'authorPlaceholder',
          'bodyLabel', 'bodyPlaceholder',
          'savingStatusText', 'savedStatusText', 'offlineStatusText', 'errorStatusText',
          'autosaveHintText', 'retryInlineBtn',
          'clearDraftBtn', 'clearModalTitle', 'clearModalBody',
          'clearModalCancelBtn', 'clearModalConfirmBtn', 'finishAndFoldBtn'
        ]) &&
        m.keys().hasOnly([
          'backBtn', 'heading', 'privacyNoticeBody', 'deletionPolicyNote',
          'titleLabel', 'titlePlaceholder', 'authorLabel', 'authorPlaceholder',
          'bodyLabel', 'bodyPlaceholder',
          'savingStatusText', 'savedStatusText', 'offlineStatusText', 'errorStatusText',
          'autosaveHintText', 'retryInlineBtn',
          'clearDraftBtn', 'clearModalTitle', 'clearModalBody',
          'clearModalCancelBtn', 'clearModalConfirmBtn', 'finishAndFoldBtn'
        ]) &&
        isBoundedString(m.backBtn, 0, 200) &&
        isBoundedString(m.heading, 0, 300) &&
        isBoundedString(m.privacyNoticeBody, 0, 1000) &&
        isBoundedString(m.deletionPolicyNote, 0, 1000) &&
        isBoundedString(m.titleLabel, 0, 200) &&
        isBoundedString(m.titlePlaceholder, 0, 300) &&
        isBoundedString(m.authorLabel, 0, 200) &&
        isBoundedString(m.authorPlaceholder, 0, 300) &&
        isBoundedString(m.bodyLabel, 0, 200) &&
        isBoundedString(m.bodyPlaceholder, 0, 400) &&
        isBoundedString(m.savingStatusText, 0, 200) &&
        isBoundedString(m.savedStatusText, 0, 200) &&
        isBoundedString(m.offlineStatusText, 0, 300) &&
        isBoundedString(m.errorStatusText, 0, 300) &&
        isBoundedString(m.autosaveHintText, 0, 300) &&
        isBoundedString(m.retryInlineBtn, 0, 200) &&
        isBoundedString(m.clearDraftBtn, 0, 200) &&
        isBoundedString(m.clearModalTitle, 0, 400) &&
        isBoundedString(m.clearModalBody, 0, 1000) &&
        isBoundedString(m.clearModalCancelBtn, 0, 200) &&
        isBoundedString(m.clearModalConfirmBtn, 0, 200) &&
        isBoundedString(m.finishAndFoldBtn, 0, 200);
    }

    function isValidStepEMap(m) {
      return m is map &&
        m.keys().hasAll([
          'savingOverlayTitle', 'savingOverlayBody',
          'savedHeading', 'savedSubheading', 'skipAnimationBtn',
          'thankYouTitle', 'thankYouSubtitle', 'heartSymbol', 'referenceCodeLabel',
          'backToDeskBtn', 'writeAnotherBtn', 'editAgainBtn',
          'unsavedWarningTitle', 'unsavedWarningBody', 'retrySaveBtn', 'backToWriteBtn'
        ]) &&
        m.keys().hasOnly([
          'savingOverlayTitle', 'savingOverlayBody',
          'savedHeading', 'savedSubheading', 'skipAnimationBtn',
          'thankYouTitle', 'thankYouSubtitle', 'heartSymbol', 'referenceCodeLabel',
          'backToDeskBtn', 'writeAnotherBtn', 'editAgainBtn',
          'unsavedWarningTitle', 'unsavedWarningBody', 'retrySaveBtn', 'backToWriteBtn'
        ]) &&
        isBoundedString(m.savingOverlayTitle, 0, 400) &&
        isBoundedString(m.savingOverlayBody, 0, 1000) &&
        isBoundedString(m.savedHeading, 0, 300) &&
        isBoundedString(m.savedSubheading, 0, 500) &&
        isBoundedString(m.skipAnimationBtn, 0, 200) &&
        isBoundedString(m.thankYouTitle, 0, 400) &&
        isBoundedString(m.thankYouSubtitle, 0, 500) &&
        isBoundedString(m.heartSymbol, 0, 40) &&
        isBoundedString(m.referenceCodeLabel, 0, 200) &&
        isBoundedString(m.backToDeskBtn, 0, 200) &&
        isBoundedString(m.writeAnotherBtn, 0, 200) &&
        isBoundedString(m.editAgainBtn, 0, 200) &&
        isBoundedString(m.unsavedWarningTitle, 0, 400) &&
        isBoundedString(m.unsavedWarningBody, 0, 1000) &&
        isBoundedString(m.retrySaveBtn, 0, 200) &&
        isBoundedString(m.backToWriteBtn, 0, 200);
    }

    function isValidPublishedSiteConfig(data) {
      return data.keys().hasAll([
          'configId', 'authorUid', 'letterOrderIds', 'siteTitle', 'globalBars',
          'cover', 'stepA', 'stepB', 'stepC', 'stepD', 'stepE',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'configId', 'authorUid', 'letterOrderIds', 'siteTitle', 'globalBars',
          'cover', 'stepA', 'stepB', 'stepC', 'stepD', 'stepE',
          'createdAt', 'updatedAt'
        ]) &&
        data.configId is string &&
        data.configId.size() <= 32 &&
        data.configId.matches('^[a-zA-Z0-9_-]+$') &&
        data.configId == 'live_site' &&
        isValidUid(data.authorUid) &&
        data.authorUid == request.auth.uid &&
        data.letterOrderIds is list &&
        data.letterOrderIds.size() >= 1 &&
        data.letterOrderIds.size() <= 30 &&
        isValidId(data.letterOrderIds[0]) &&
        isBoundedString(data.siteTitle, 1, 200) &&
        isValidGlobalBarsMap(data.globalBars) &&
        isValidCoverMap(data.cover) &&
        isValidStepAMap(data.stepA) &&
        isValidStepBMap(data.stepB) &&
        isValidStepCMap(data.stepC) &&
        isValidStepDMap(data.stepD) &&
        isValidStepEMap(data.stepE) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidPublishedLetter(data) {
      return data.keys().hasAll([
          'id', 'authorUid', 'isOwnerApprovedForProduction',
          'letterTitle', 'senderLabel', 'dateLabel', 'salutation',
          'paragraphs', 'signOff', 'senderName', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'authorUid', 'isOwnerApprovedForProduction',
          'letterTitle', 'senderLabel', 'dateLabel', 'salutation',
          'paragraphs', 'signOff', 'senderName', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidUid(data.authorUid) &&
        data.authorUid == request.auth.uid &&
        data.isOwnerApprovedForProduction is bool &&
        isBoundedString(data.letterTitle, 1, 200) &&
        isBoundedString(data.senderLabel, 0, 120) &&
        isBoundedString(data.dateLabel, 0, 120) &&
        isBoundedString(data.salutation, 0, 300) &&
        data.paragraphs is list &&
        data.paragraphs.size() >= 1 &&
        data.paragraphs.size() <= 80 &&
        isBoundedString(data.paragraphs[0], 0, 4000) &&
        isBoundedString(data.signOff, 0, 200) &&
        isBoundedString(data.senderName, 0, 120) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSharedReplyLetter(data) {
      return data.keys().hasAll([
          'letterId', 'authorUid', 'lastEditorUid', 'visibility',
          'title', 'author', 'body', 'version', 'recoveryState',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'letterId', 'authorUid', 'lastEditorUid', 'visibility',
          'title', 'author', 'body', 'version', 'recoveryState',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.letterId) &&
        isValidUid(data.authorUid) &&
        isValidUid(data.lastEditorUid) &&
        data.lastEditorUid == request.auth.uid &&
        data.visibility is string &&
        data.visibility.size() <= 16 &&
        data.visibility == 'public' &&
        isBoundedString(data.title, 1, 200) &&
        isBoundedString(data.author, 1, 120) &&
        isBoundedString(data.body, 1, 8000) &&
        data.version is int &&
        data.version >= 1 &&
        data.version <= 100000 &&
        data.recoveryState is string &&
        data.recoveryState.size() <= 20 &&
        (data.recoveryState == 'synced' || data.recoveryState == 'completed') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    // Trusted Admin Role Registry (Client writes forbidden)
    match /admins/{adminUid} {
      allow get: if isVerifiedUser() && isValidUid(adminUid) && (request.auth.uid == adminUid || isAdmin());
      allow list: if false;
      allow create, update, delete: if false;
    }

    // Singleton Live Website Copy & Letter Order (Public single-doc read, Verified Admin write)
    match /published_site/{configId} {
      allow get: if isValidId(configId) && configId == 'live_site';
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(configId) &&
        configId == 'live_site' &&
        isValidPublishedSiteConfig(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidPublishedSiteConfig(incoming()) &&
        isValidId(configId) &&
        configId == 'live_site' &&
        incoming().configId == existing().configId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'authorUid', 'letterOrderIds', 'siteTitle', 'globalBars',
          'cover', 'stepA', 'stepB', 'stepC', 'stepD', 'stepE', 'updatedAt'
        ]) &&
        isAdmin();

      allow delete: if false;
    }

    // Published Owner Letters on Desk & Mailbox (Public single-doc read by known ID, Verified Admin write)
    match /published_letters/{letterId} {
      allow get: if isValidId(letterId);
      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(letterId) &&
        incoming().id == letterId &&
        isValidPublishedLetter(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        isAdmin();

      allow update: if isVerifiedUser() &&
        isValidPublishedLetter(incoming()) &&
        isValidId(letterId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'authorUid', 'isOwnerApprovedForProduction',
          'letterTitle', 'senderLabel', 'dateLabel', 'salutation',
          'paragraphs', 'signOff', 'senderName', 'updatedAt'
        ]) &&
        isAdmin();

      allow delete: if isVerifiedUser() &&
        isValidId(letterId) &&
        letterId != 'apology' &&
        letterId != 'birthday' &&
        isAdmin();
    }

    // Shared Public Reply Letters (Readable by all visitors via visibility == 'public', editable by creator or Admin)
    match /shared_replies/{replyId} {
      allow get: if isValidId(replyId) && (resource == null || existing().visibility == 'public');
      allow list: if existing().visibility == 'public';

      allow create: if isVerifiedUser() &&
        isValidId(replyId) &&
        incoming().letterId == replyId &&
        incoming().authorUid == request.auth.uid &&
        isValidSharedReplyLetter(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidSharedReplyLetter(incoming()) &&
        isValidId(replyId) &&
        incoming().letterId == existing().letterId &&
        incoming().authorUid == existing().authorUid &&
        incoming().visibility == existing().visibility &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'lastEditorUid', 'title', 'author', 'body', 'version', 'recoveryState', 'updatedAt'
        ]) &&
        (request.auth.uid == existing().authorUid || isAdmin());

      allow delete: if isVerifiedUser() &&
        isValidId(replyId) &&
        (request.auth.uid == existing().authorUid || isAdmin());
    }
  }
}
