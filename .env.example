# GEMINI_API_KEY: Optional in this project (no unsolicited AI features used).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_GAS_WEB_APP_URL: Optional Google Apps Script Web App URL (/exec)
# Configure this after deploying Code.gs so recipients can save letters without Google Login.
VITE_GAS_WEB_APP_URL=""

# VITE_PRODUCTION_LETTER_APPROVED: Set to "true" ONLY after the owner replaces placeholder letter content in src/content/letters.ts
VITE_PRODUCTION_LETTER_APPROVED="false"
